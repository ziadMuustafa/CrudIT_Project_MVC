@using CrudIT_Project.ViewModels 

@model CourseDepInstractorcs // this is the view model that contains the course, department and instructors

@{
    ViewData["Title"] = "Create";
    Layout = "_AdvLayout";
}


<!-- Add FontAwesome for Icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<!-- Custom Styles for Color Scheme -->
<style>
    /* Custom Color Scheme */
    .bg-custom-header {
        background-color: #2C3E50; /* Dark blue-gray */
        color: #ECF0F1; /* Light gray */
    }

    .btn-custom-primary {
        background-color: #3498DB; /* Bright blue */
        border-color: #3498DB;
        color: white;
    }

        .btn-custom-primary:hover {
            background-color: #2980B9; /* Darker blue on hover */
            border-color: #2980B9;
        }

    .form-control-custom:focus {
        border-color: #3498DB; /* Bright blue */
        box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25); /* Matching shadow */
    }

    .form-label-custom {
        color: #2C3E50; /* Dark blue-gray */
        font-weight: bold;
    }

    .invalid-feedback-custom {
        color: #E74C3C; /* Red for error messages */
    }

    body {
        background-color: #ECF0F1; /* Light gray background */
    }
</style>

<!-- Page Header -->
<div class="container-fluid p-4 bg-custom-header">
    <h1 class="text-center" style="font-family:monospace ;">Create Course</h1>
</div>

<!-- Create Form -->
<div class="container mt-5">

    <form action="/Course/Create/@Model" method="post" class="needs-validation" novalidate>
        <!-- Name Field -->

        <div>
            <div asp-validation-summary="All" class="text-danger"></div>

        </div>

        <input type="hidden" name="Id" value="@Model.CourseId" />

        <div class="mb-3">
            <label for="Name" class="form-label form-label-custom">Name</label>
            <input type="text" class="form-control form-control-custom" id="Name" name="Name" value="@Model?.Name" required>
            <span asp-validation-for="Name" class="text-danger"></span>


        </div>

        <!-- Image URL Field -->
        <div class="mb-3">
            <label for="Degree" class="form-label form-label-custom">Degree</label>
            <input type="number" class="form-control form-control-custom" id="Degree" name="Degree" value="@Model?.Degree" required>
            <span asp-validation-for="Degree" class="text-danger"></span>


        </div>

        <!-- Salary Field -->
        <div class="mb-3">
            <label for="Salary" class="form-label form-label-custom">MinDegree</label>
            <input type="number" class="form-control form-control-custom" id="MinDegree" name="MinDegree" value="@Model?.MinDegree" required>
            <span asp-validation-for="Degree" class="text-danger"></span>


        </div>

        <!-- Courses and Departments Dropdowns -->
        <div class="row">

            <div class="col-md-6 mb-3">
                <label for="Department" class="form-label form-label-custom">Department</label>
                <select class="form-select form-control-custom" id="Department" name="DepartmentId" required>
                    <option value="">Select a department</option>
                    @for (int counter = 0; counter < Model?.Departments?.Count; counter++)
                    {
                        <option value="@Model?.Departments[counter].Id">@Model?.Departments?[counter].Name</option>
                    }
                </select>
                <div class="invalid-feedback invalid-feedback-custom">
                    Please select a department.
                </div>
            </div>
        </div>

        <!-- Instructors Multi-Select Dropdown -->
        <div class="form-group">
            <label asp-for="Instractors" class="control-label">Instructors</label>
            <select asp-for="SelectedInstructorIds" class="form-control" multiple>
                @foreach (var instructor in Model.Instractors)
                {
                    <option value="@instructor.Id">@instructor.Name</option>
                }
            </select>
            <span asp-validation-for="SelectedInstructorIds" class="text-danger"></span>
        </div>



        <!-- Submit Button -->
        <div class="text-center">
            <button type="submit" class="btn btn-custom-primary">
                <i class="fas fa-save"></i> Create Course
            </button>
        </div>
    </form>
</div>

<!-- Bootstrap Validation Script -->
<script>
    (function () {
        'use strict';
        window.addEventListener('load', function () {
            var forms = document.getElementsByClassName('needs-validation');
            Array.prototype.filter.call(forms, function (form) {
                form.addEventListener('submit', function (event) {
                    if (form.checkValidity() === false) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        }, false);
    })();
</script>

<!-- Bootstrap JS (Optional, only needed for advanced features) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>


@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}