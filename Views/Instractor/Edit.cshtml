@using CrudIT_Project.ViewModels
@{
    ViewData["Title"] = "Edit";
    Layout = "_AdvLayout";
}

@model InstractorCourseDep

<!-- Add FontAwesome for Icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<!-- Custom Styles for Color Scheme -->
<style>
    /* Custom Color Scheme */
    .bg-custom-header {
        background-color: #2C3E50; /* Dark blue-gray */
        color: #ECF0F1; /* Light gray */
    }

    .btn-custom-primary {
        background-color: #3498DB; /* Bright blue */
        border-color: #3498DB;
        color: white;
    }

        .btn-custom-primary:hover {
            background-color: #2980B9; /* Darker blue on hover */
            border-color: #2980B9;
        }

    .form-control-custom:focus {
        border-color: #3498DB; /* Bright blue */
        box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25); /* Matching shadow */
    }

    .form-label-custom {
        color: #2C3E50; /* Dark blue-gray */
        font-weight: bold;
    }

    .invalid-feedback-custom {
        color: #E74C3C; /* Red for error messages */
    }
</style>

<!-- Page Header -->
<div class="container-fluid p-4 bg-custom-header">
    <h1 class="text-center" style="font-family:monospace">Edit Instructor</h1>
</div>

<!-- Edit Form -->
<div class="container mt-4">
    <form action="/Instractor/Edit/@Model.TempId" method="post" class="needs-validation" novalidate>
        <input type="hidden" name="TempId" value="@Model.TempId" />

        <!-- Name Field -->
        <div class="mb-3">
            <label for="Name" class="form-label form-label-custom">Name</label>
            <input type="text" class="form-control form-control-custom" id="Name" name="Name" value="@Model.Name" required>
            <span asp-validation-for="Name"></span>
            <div class="invalid-feedback invalid-feedback-custom">
                Please provide a name.
            </div>
        </div>

        <!-- Image URL Field -->
        <div class="mb-3">
            <label for="Img" class="form-label form-label-custom">Image URL</label>
            <input type="text" class="form-control form-control-custom" id="Img" name="Img" value="@Model.Img" required>
            <span asp-validation-for="Img"></span>
            <div class="invalid-feedback invalid-feedback-custom">
                Please provide an image URL.
            </div>
        </div>

        <!-- Salary Field -->
        <div class="mb-3">
            <label for="Salary" class="form-label form-label-custom">Salary</label>
            <input type="number" class="form-control form-control-custom" id="Salary" name="Salary" value="@Model.Salary" required>
            <span asp-validation-for="Salary"></span>
            <div class="invalid-feedback invalid-feedback-custom">
                Please provide a salary.
            </div>
        </div>

        <!-- Address Field -->
        <div class="mb-3">
            <label for="Address" class="form-label form-label-custom">Address</label>
            <input type="text" class="form-control form-control-custom" id="Address" name="Address" value="@Model.Address" required>
            <span asp-validation-for="Address"></span>
            <div class="invalid-feedback invalid-feedback-custom">
                Please provide an address.
            </div>
        </div>

        <!-- Courses and Departments Dropdowns -->
        <div class="row">
            <div class="col-md-6 mb-3">
                <label for="Course" class="form-label form-label-custom">Course</label>
                <select class="form-select form-control-custom" id="Course" name="CourseId" required>
                    @foreach (Course course in Model.courses)
                    {
                        <option value="@course.Id" selected="@(course.Id == Model.CourseId ? "selected" : null)">@course.Name</option>
                    }
                </select>
                <span asp-validation-for="CourseId"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label for="Department" class="form-label form-label-custom">Department</label>
                <select class="form-select form-control-custom" id="Department" name="DepartmentId" required>
                    @foreach (Department dep in Model.departments)
                    {
                        <option value="@dep.Id" selected="@(dep.Id == Model.DepartmentId ? "selected" : null)">@dep.Name</option>
                    }
                </select>
                <span asp-validation-for="DepartmentId"></span>
            </div>
        </div>

        <!-- Save Button -->
        <div class="text-center">
            <button class="btn btn-custom-primary" type="submit">
                <i class="fas fa-save"></i> Save Changes
            </button>
        </div>
    </form>
</div>

<!-- Optional: Add Bootstrap JS for interactivity -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<!-- Form Validation Script -->
<script>
    (function () {
        'use strict';
        var forms = document.querySelectorAll('.needs-validation');
        Array.prototype.slice.call(forms).forEach(function (form) {
            form.addEventListener('submit', function (event) {
                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                form.classList.add('was-validated');
            }, false);
        });
    })();
</script>