@{
    ViewData["Title"] = "GetAll";
    Layout = "_MyLayout";
}

@model IEnumerable<Instractor>

<!-- Add FontAwesome for Icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<!-- Custom Styles for Color Scheme -->
<style>
    /* Custom Color Scheme */
    .bg-custom-header {
        background-color: #2C3E50; /* Dark blue-gray */
        color: #ECF0F1; /* Light gray */
    }

    .btn-custom-primary {
        background-color: #3498DB; /* Bright blue */
        border-color: #3498DB;
        color: white;
    }

        .btn-custom-primary:hover {
            background-color: #2980B9; /* Darker blue on hover */
            border-color: #2980B9;
        }

    .btn-custom-warning {
        background-color: #F1C40F; /* Yellow */
        border-color: #F1C40F;
        color: white;
    }

        .btn-custom-warning:hover {
            background-color: #F39C12; /* Darker yellow on hover */
            border-color: #F39C12;
        }

    .table-custom {
        background-color: #FFFFFF; /* White background */
        border: 1px solid #BDC3C7; /* Light gray border */
    }

        .table-custom thead {
            background-color: #34495E; /* Dark blue-gray */
            color: #ECF0F1; /* Light gray */
        }

        .table-custom tbody tr:hover {
            background-color: #F5F5F5; /* Light gray on hover */
        }

    .img-thumbnail-custom {
        border: 2px solid #BDC3C7; /* Light gray border */
    }
</style>

<!-- Page Header -->
<div class="container-fluid p-4 bg-custom-header">
    <h1 class="text-center" style="font-family: monospace;">Instructor List</h1>
</div>

<!-- Create Button -->
<div class="container mt-4">
    <a href="/Instractor/Create" class="btn btn-custom-primary" style="font-family:monospace">
        <i class="fas fa-plus"></i> Create New Instructor
    </a>
</div>

<!-- Back Button -->
<div class="container mt-4">
    <a href="/Home/Index" class="btn btn-custom-primary" style="font-family:monospace">
        <i class="fas fa-plus"></i> Back
    </a>
</div>


<!-- Table -->
<div class="container mt-4">
    <div class="table-responsive">
        <table class="table table-custom table-hover shadow" style="font-family : monospace">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th>Image</th>
                    <th>Salary</th>
                    <th>Address</th>
                    <th>Course</th>
                    <th>Department</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Name</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.Img))
                            {
                                <img src="@item.Img" alt="Instructor Image" class="img-thumbnail img-thumbnail-custom" style="width: 50px; height: 50px;" />
                            }
                            else
                            {
                                <span class="text-muted">No Image</span>
                            }
                        </td>
                        <td>@item.Salary</td>
                        <td>@item.Address</td>
                        <td>@item?.Course?.Name</td>
                        <td>@item?.Department?.Name</td>
                        <td>
                            <a href="/Instractor/Edit/@item?.Id" class="btn btn-custom-warning btn-sm">
                                <i class="fas fa-edit"></i> Edit
                            </a>

                            <a href="/Instractor/Delete/@item?.Id" class="btn btn-custom-warning btn-sm">
                                <i class="fas fa-edit"></i> Delete
                            </a>

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Optional: Add Bootstrap JS for interactivity -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>